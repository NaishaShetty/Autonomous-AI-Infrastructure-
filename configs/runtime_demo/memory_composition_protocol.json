    "SAFETY_XZ": {
      "factors": ["X_resource_pressure", "Z_configuration_drift"],
      "features": {"gpu_utilization": 0.58, "queue_depth": 0.52, "latency_ms": 0.34, "error_rate": 0.48, "config_drift": 0.62, "throughput_drop": 0.50},
