  "baselines": {
    "B0_no_memory": "fixed retry with no historical experiences",
    "B1_nearest_neighbor": "single closest experience, historical action copy, same safety gate, execution, validation",
    "B2_memory_planner": "canonical FailureMemory plus Diagnosis plus RuleBasedRecoveryPlanner",
    "B3_observable_feature": "nearest action centroid using observable features only"
  },
  "latent_factors": {
