    "Y_latency_congestion": {"features": {"gpu_utilization": 0.28, "queue_depth": 0.80, "latency_ms": 0.88, "error_rate": 0.42, "config_drift": 0.10, "throughput_drop": 0.54}},
    "Z_configuration_drift": {"features": {"gpu_utilization": 0.24, "queue_depth": 0.22, "latency_ms": 0.40, "error_rate": 0.62, "config_drift": 0.90, "throughput_drop": 0.30}}
  },
  "training_experiences": [
