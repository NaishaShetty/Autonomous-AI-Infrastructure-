  "metrics": [
    "relevant_retrieval_precision", "relevant_retrieval_recall", "relevant_experiences_used", "similarity_distribution",
    "diagnosis_confidence", "diagnosis_uncertainty", "diagnosis_correctness", "selected_action", "optimal_action_rate",
