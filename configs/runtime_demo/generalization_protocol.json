  "conditions": {
    "C0_no_memory": "empty memory",
    "C1_relevant_memory": "related training memories for the target failure class",
    "C2_irrelevant_memory": "memory from a distant failure class",
    "C3_conflicting_memory": "equal-similarity positive memories for different actions",
    "C4_negative_experience": "relevant failed action memory",
    "C5_safety_conflict": "relevant action marked unsafe by current environment",
