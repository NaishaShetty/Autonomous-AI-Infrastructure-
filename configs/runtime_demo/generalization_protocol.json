  "training_experiences": [
    {"id": "train-A-retry-success", "failure_type": "A_gpu_memory_shift", "action": "retry", "validation_status": "RECOVERED", "confidence": 0.9},
    {"id": "train-A-reconfigure-failed", "failure_type": "A_gpu_memory_shift", "action": "reconfigure", "validation_status": "FAILED", "confidence": 0.8},
    {"id": "train-B-reconfigure-success", "failure_type": "B_inference_timeout_shift", "action": "reconfigure", "validation_status": "RECOVERED", "confidence": 0.9},
    {"id": "train-B-retry-failed", "failure_type": "B_inference_timeout_shift", "action": "retry", "validation_status": "FAILED", "confidence": 0.8},
    {"id": "train-C-rollback-success", "failure_type": "C_configuration_drift_shift", "action": "rollback", "validation_status": "RECOVERED", "confidence": 0.9},
    {"id": "train-C-reconfigure-failed", "failure_type": "C_configuration_drift_shift", "action": "reconfigure", "validation_status": "FAILED", "confidence": 0.8},
    {"id": "train-D-retry-failed", "failure_type": "D_ambiguous_unsafe_shift", "action": "retry", "validation_status": "FAILED", "confidence": 0.7},
    {"id": "train-D-reconfigure-failed", "failure_type": "D_ambiguous_unsafe_shift", "action": "reconfigure", "validation_status": "FAILED", "confidence": 0.7},
