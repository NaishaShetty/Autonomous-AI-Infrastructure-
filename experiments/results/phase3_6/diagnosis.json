    "protocol35_attack_matrix": [
      {
        "id": "feature_noise_mild",
        "kind": "covariate_shift_attack",
        "mechanism": "feature_noise",
        "parameters": {
          "std": 0.5
        },
        "severity": "mild",
        "seen_or_unseen": "unseen",
        "attack_ordinal": 1,
        "rationale": "Additive N(0, 0.5^2) noise on every one of the 5 raw features (which are themselves N(0,1) by construction -- see src/data/synthetic.py), applied only to regime-3/4 context dicts AFTER generation. std=0.5 is half the native feature scale, chosen a priori as the 'mild' anchor before any evaluation was run. Represents corrupted/noisy telemetry reaching the deployed system: the true label-generating relationship (base_w, drift) is untouched, only what every candidate OBSERVES changes -- a covariate-shift attack, not concept drift."
      },
      {
        "id": "feature_noise_severe",
        "kind": "covariate_shift_attack",
        "mechanism": "feature_noise",
        "parameters": {
          "std": 1.5
        },
        "severity": "severe",
        "seen_or_unseen": "unseen",
        "attack_ordinal": 2,
        "rationale": "Same mechanism as feature_noise_mild, std=1.5 (1.5x native feature scale), chosen a priori as the 'severe' anchor -- fixed before evaluation, not tuned to any outcome. Provides a dose-response comparison against feature_noise_mild."
      },
      {
        "id": "feature_dropout",
        "kind": "covariate_shift_attack",
        "mechanism": "feature_dropout",
        "parameters": {
          "dropped_features": [
            "f2",
            "f4"
          ]
        },
        "severity": "n/a -- binary corruption, not a graded severity",
        "seen_or_unseen": "unseen",
        "attack_ordinal": 3,
        "rationale": "Zeroes features f2 and f4 (the 2nd and 4th of 5 features by the fixed FEATURE_NAMES order -- a systematic 'every other feature starting at index 1' rule stated here before evaluation, not chosen after inspecting which features matter most) for every regime-3/4 sample. Simulates a sensor/telemetry field going dark or being stripped -- a qualitatively different corruption (structural, not magnitude-graded) from the noise attacks. Fully deterministic, no RNG needed."
      }
    ],
    "diagnosis_rule": "deterministic, see src/evaluation/diagnosis.py"
  },
