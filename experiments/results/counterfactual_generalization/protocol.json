{
  "baselines": {
    "B0_no_memory": "fixed retry action with no historical training data",
    "B1_nearest_neighbor": "nearest declared training manifestation copies its validated action",
    "B2_memory_planner": "current FailureMemory plus Diagnosis plus RecoveryPlanner",
    "B3_observable_centroid": "action centroid classifier trained only on observable training contexts"
  },
  "conditions": {
    "C0_no_memory": "empty FailureMemory and no episodic training evidence",
    "C1_training_memory": "A1+A2, B1+B2, or C1+C2 available; evaluation A3/B3/C3 is absent",
    "C2_irrelevant_memory": "training experiences from a different latent mechanism",
    "C3_exact_memory_removed": "same training-only set as C1; explicit assertion that A3/B3/C3 is absent",
    "C4_negative_transfer": "historically successful action is ineffective in an unseen manifestation",
    "C5_safety_override": "historically successful action is unsafe in the current world",
    "C6_uncertainty_ladder": "D0 through D4 contexts under a fixed policy",
    "C7_counterfactual_pair": "same seed, observation, simulator, and constraints; memory availability is the only manipulation"
  },
  "distance_bands": {
    "D0_exact": {
      "description": "one declared training manifestation reused as evaluation context"
    },
    "D1_near": {
      "description": "small surface change from a declared training manifestation"
    },
    "D2_moderate": {
      "description": "unseen A3/B3/C3 manifestation from the same latent mechanism"
    },
    "D3_large": {
      "description": "unseen manifestation with larger observable displacement"
    },
    "D4_unrelated": {
      "description": "context from a different latent mechanism and no shared mechanism label"
    }
  },
